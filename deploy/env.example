# Copy to deploy/.env and fill in. Never commit the real file.

# The address families and softphones use. DNS must point at this machine.
TREELINE_DOMAIN=phone.example.com

# Long random strings. Make them with:  openssl rand -base64 36
ARI_PASS=change-me

# Email for sign-in codes and alerts (any SMTP service). Without it, nothing is sent.
TREELINE_SMTP_HOST=smtp.example.com
TREELINE_SMTP_PORT=587
TREELINE_SMTP_USER=
TREELINE_SMTP_PASS=
TREELINE_MAIL_FROM=Treeline <no-reply@example.com>

# Notifications on parents' phones (optional). Make a key pair, then paste both lines here:
#   docker compose -f deploy/docker-compose.prod.yml run --rm --no-deps --entrypoint python api make_vapid.py
TREELINE_VAPID_PUBLIC=
TREELINE_VAPID_PRIVATE=
TREELINE_VAPID_SUBJECT=mailto:you@example.com

# Optional: a STUN/TURN server for softphones on mobile data. JSON list.
# TREELINE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]

# Only if you host the web pages on a static site (scripts/build_static.py): its address.
# TREELINE_CORS_ORIGINS=https://your-site.example

# Only for registering Treeline rotary phones at the factory (docs/HARDWARE.md). Leave
# empty to keep that endpoint off. A long random string.
# TREELINE_FACTORY_KEY=

# How many days of backups to keep.
BACKUP_KEEP_DAYS=14
