# Non-secret settings for the API and the controller, generated by treeline-config. The secrets are fetched
# from SSM into /run/treeline/env by treeline-fetch-secrets.
TREELINE_ENV=production
TREELINE_DB=/var/lib/treeline/data/treeline.db
TREELINE_PJSIP_FILE=/var/lib/treeline/generated/pjsip_handsets.conf
TREELINE_WEB=/opt/treeline/current/web
TREELINE_PUBLIC_HOST=@DOMAIN@
TREELINE_PUBLIC_ORIGIN=https://@DOMAIN@
TREELINE_PUBLIC_WS_URL=wss://@DOMAIN@/ws
TREELINE_TRUST_PROXY=1
ARI_URL=http://127.0.0.1:8088/ari
TREELINE_SMTP_HOST=email-smtp.@REGION@.amazonaws.com
TREELINE_SMTP_PORT=587
TREELINE_MAIL_FROM=Treeline <no-reply@@MAIL_DOMAIN@>
TREELINE_VAPID_SUBJECT=mailto:@VAPID_CONTACT@
PYTHONDONTWRITEBYTECODE=1
