# Treeline's Caddy, generated by treeline-config from deploy/native/templates/Caddyfile.tmpl. Do not edit by hand.
#
# - one ACME issuer, pinned, and one storage root, so the certificate is at a known path (treeline-certsync)
# - only /ws reaches Asterisk (its web server is on 127.0.0.1:8088); ARI is never proxied
# - HTTP/3 is off (UDP 443 is not open on the firewall; advertising it would only slow clients down)
# - port 80 only redirects (and answers ACME challenges, which Caddy handles before any site)
{
	storage file_system /var/lib/treeline/caddy
	admin off
	servers {
		protocols h1 h2
	}
@ACME_GLOBAL@
}

http:// {
	redir https://@DOMAIN@{uri} 308
}

@DOMAIN@ {
	tls {
		protocols tls1.2 tls1.3
		issuer acme {
			dir @ACME_DIR@
@ACME_ROOT@
		}
	}
	encode gzip
	request_body {
		max_size 2MB
	}

	@asterisk_ws path /ws
	reverse_proxy @asterisk_ws 127.0.0.1:8088

	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
@APEX_BLOCK@
