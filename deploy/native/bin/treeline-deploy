#!/opt/treeline/tools/bin/python -I
"""Treeline deploy agent. Runs as root, so it trusts nothing it has not verified. See docs/DEPLOY_AWS.md, work package 2.

    treeline-deploy                          what the timer runs: deploy a newer release if one exists, in the quiet window, when idle
    treeline-deploy --version vX.Y.Z         fetch that release and deploy it now (still verified, still health-checked)
    treeline-deploy --tarball F [--sig S]    deploy a release from local files (offline installs and the CI job; still verified)
    treeline-deploy --rollback               go back to the previous release (refused if the data layout moved since)
    treeline-deploy status
    treeline-deploy releases                 read-only: what runs, what is published, what failed (JSON; the admin page shows it)
    treeline-deploy adopt DIR                first install: stage the unpacked release DIR (called by install.sh)
    treeline-deploy install-asterisk DIR     install (or check) the Asterisk build of the installed release DIR (called by install.sh)

Order of events for a deploy: verify the signature -> unpack beside the current release -> check the release's own
claims -> build its virtualenv from the hash-pinned lock -> dry-run its configuration -> (wait for a quiet moment) ->
switch the symlinks and restart -> wait for /api/health to report the new release and for Asterisk to be running the new
build -> otherwise roll back. Each release carries its own Asterisk (format 2): installed beside the others in /opt/asterisk/<id>,
checked file by file, never trusted from a state file (the running build is read from the process).
Exit codes: 0 deployed / nothing to do, 1 failed and rolled back, 2 usage, 3 REFUSED (bad signature or release), 4 busy, 5 failed and could not roll back.
"""

import datetime as dt
import fcntl
import json
import os
import re
import shutil
import stat
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import treeline_common as common  # noqa: E402
import treeline_release as rel  # noqa: E402

HEALTH_URL = os.environ.get("TREELINE_HEALTH_URL", "http://127.0.0.1:8080/api/health")
HEALTH_SECONDS = int(os.environ.get("TREELINE_HEALTH_SECONDS", "90"))
KEEP_RELEASES = 3
SERVICES = ("treeline-api", "treeline-controller")
GITHUB_HOSTS = ("github.com", "api.github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com")
MAX_DOWNLOAD = 400 * 1024 * 1024


class Refused(Exception):
    """A release that must not be deployed (exit 3)."""


class Busy(Exception):
    """A call is in progress, or it is not the quiet window (exit 4)."""


class Failed(Exception):
    pass


def log(msg):
    print(f"{dt.datetime.now(dt.timezone.utc):%FT%TZ} treeline-deploy: {msg}", flush=True)


def paths():
    return {"current": os.path.join(common.OPT, "current"), "releases": os.path.join(common.OPT, "releases"),
            "state": os.path.join(common.STATE, "deploy"), "run": os.path.join(common.RUN, "deploy.lock")}


def is_ci(host_env):
    return host_env.get("TREELINE_CI") == "1"


# ------------------------------------------------------------------ versions
def vkey(version):
    m = re.match(r"^v(\d+)\.(\d+)\.(\d+)(?:-(.+))?$", version)
    if not m:
        raise ValueError(version)
    return (int(m[1]), int(m[2]), int(m[3]), 1 if m[4] is None else 0, m[4] or "")


def installed(p):
    out = []
    try:
        for n in os.listdir(p["releases"]):
            if rel.VERSION_RE.match(n):
                out.append(n)
    except FileNotFoundError:
        pass
    return sorted(out, key=vkey)


def current_version(p):
    target = rel.current(p["current"])
    return os.path.basename(target) if target else None


# ------------------------------------------------------------------ fetching
def https_get(url, limit=MAX_DOWNLOAD, hosts=GITHUB_HOSTS, allow_http=False):
    """Download with a size cap. Only https, only GitHub's hosts, unless the CI job's local base URL is in use."""
    host = re.match(r"^(https?)://([^/:]+)", url)
    if not host or (host[1] != "https" and not allow_http) or (not allow_http and host[2] not in hosts):
        raise Refused(f"refusing to fetch {url!r}")
    req = urllib.request.Request(url, headers={"User-Agent": "treeline-deploy", "Accept": "application/octet-stream, application/json"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        final = re.match(r"^(https?)://([^/:]+)", resp.geturl())
        if not allow_http and (final[1] != "https" or final[2] not in hosts):
            raise Refused(f"a redirect led away from GitHub: {resp.geturl()!r}")
        data = resp.read(limit + 1)
    if len(data) > limit:
        raise Refused("the download is larger than allowed")
    return data


def source(host_env):
    base = host_env.get("TREELINE_RELEASE_BASE")           # the CI job only (install.sh --ci); refused otherwise
    if base:
        if host_env.get("TREELINE_CI") != "1":
            raise Refused("TREELINE_RELEASE_BASE is set but this is not a CI install")
        return base.rstrip("/"), True
    repo = host_env.get("TREELINE_RELEASE_REPO", "")
    if not re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", repo):
        raise Failed("TREELINE_RELEASE_REPO is not set in /etc/treeline/host.env (run install.sh with --release-repo OWNER/REPO)")
    return f"https://github.com/{repo}/releases", False


def published(releases):
    """[(tag, published_at)] of the PUBLISHED plain vX.Y.Z releases in GitHub's list, newest first (drafts, prereleases, the asterisk-*
    builds and odd tags are left out). Raises Failed if the answer is not a list."""
    if not isinstance(releases, list):
        raise Failed("the release list from GitHub is not a list")
    out = []
    for r in releases:
        if not isinstance(r, dict) or r.get("draft") is not False or r.get("prerelease") is not False:
            continue
        tag = r.get("tag_name")
        if not isinstance(tag, str) or not re.fullmatch(r"v\d+\.\d+\.\d+", tag):
            continue
        when = r.get("published_at")
        out.append((tag, when if isinstance(when, str) and re.fullmatch(r"[0-9T:Z+.-]{10,32}", when) else None))
    return sorted(out, key=lambda t: vkey(t[0]), reverse=True)


def pick_latest(releases):
    """The highest plain vX.Y.Z among PUBLISHED releases. The repository also holds other releases (the asterisk-* ones, which are
    prereleases of an Asterisk build and not something to deploy); GitHub's "latest" would be one of them whenever it was newer,
    so the list is read and chosen from here."""
    if not isinstance(releases, list):
        raise Failed("the release list from GitHub is not a list")
    best = None
    for r in releases:
        if not isinstance(r, dict) or r.get("draft") is not False or r.get("prerelease") is not False:
            continue
        tag = r.get("tag_name")
        if not isinstance(tag, str) or not re.fullmatch(r"v\d+\.\d+\.\d+", tag):
            continue
        if best is None or vkey(tag) > vkey(best):
            best = tag
    if best is None:
        raise Failed("GitHub lists no published release of the form vX.Y.Z")
    return best


def releases_report(p, host_env):
    """What the admin page's Releases screen shows (docs/ADMIN.md): what is running, what is published, what failed. Read-only:
    nothing is downloaded, staged or changed, and it takes no input."""
    state = read_state(p)
    cur = current_version(p)
    report = {"current": cur, "previous": state.get("previous"), "failed": [v for v in state.get("failed", []) if rel.VERSION_RE.match(str(v))],
              "asterisk": running_asterisk_id(), "published": [], "error": None}
    try:
        base, local = source(host_env)
        if local:
            rows = [(latest_version(host_env), None)]
        else:
            rows = published(json.loads(https_get(f"https://api.github.com/repos/{host_env['TREELINE_RELEASE_REPO']}/releases?per_page=100")))
        report["published"] = [{"version": v, "published_at": when, "newer": bool(cur) and vkey(v) > vkey(cur), "failed": v in report["failed"]}
                               for v, when in rows[:30]]
    except (Failed, Refused, urllib.error.URLError, OSError, ValueError) as err:
        report["error"] = f"could not read the published releases: {str(err)[:200]}"
    return report


def latest_version(host_env):
    base, local = source(host_env)
    if local:
        text = https_get(base + "/latest", hosts=(), allow_http=True).decode().strip()
    else:
        repo = host_env["TREELINE_RELEASE_REPO"]
        text = pick_latest(json.loads(https_get(f"https://api.github.com/repos/{repo}/releases?per_page=100")))
    if not rel.VERSION_RE.match(text) or "-" in text:
        raise Failed(f"the latest release name {text!r} is not a version we deploy automatically")
    return text


def fetch_release(version, dest_dir, host_env):
    if not rel.VERSION_RE.match(version):
        raise Refused(f"{version!r} is not a version")
    base, local = source(host_env)
    files = {}
    for suffix in ("", ".sig"):
        name = f"treeline-{version}.tar.gz{suffix}"
        url = f"{base}/{version}/{name}" if local else f"{base}/download/{version}/{name}"
        path = os.path.join(dest_dir, name)
        with open(path, "wb") as f:
            f.write(https_get(url, hosts=GITHUB_HOSTS, allow_http=local))
        files[suffix] = path
    return files[""], files[".sig"]


# ------------------------------------------------------------------ checks that need the machine
def data_versions():
    """{file: user_version} for the central database and every household, read as the `treeline` user (a root-owned
    -shm or -wal file would break the app), by the same SQLite the app uses."""
    code = ("import glob, json, os, sqlite3, sys\n"
            "root = sys.argv[1]\n"
            "out = {}\n"
            "for p in [os.path.join(root, 'treeline.db')] + sorted(glob.glob(os.path.join(root, 'households', '*.db'))):\n"
            "    if not os.path.exists(p): continue\n"
            "    c = sqlite3.connect('file:' + p + '?mode=ro', uri=True, timeout=10)\n"
            "    out[os.path.relpath(p, root)] = c.execute('PRAGMA user_version').fetchone()[0]\n"
            "print(json.dumps(out))\n")
    done = subprocess.run(["runuser", "-u", "treeline", "--", sys.executable, "-I", "-c", code, common.data_dir()], capture_output=True, text=True)
    if done.returncode != 0:
        raise Failed("could not read the data files' versions: " + done.stderr.strip()[-300:])
    return json.loads(done.stdout)


def calls_in_progress(ari_url="http://127.0.0.1:8088/ari", user="treeline", password=None, etc=None):
    """Open ARI channels (a call in progress, or a handset ringing). Anything unexpected counts as busy, never as idle."""
    if password is None:
        with open(os.path.join(etc or common.ETC, "ari-password"), encoding="utf-8") as f:
            password = f.read().strip()
    mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    mgr.add_password(None, ari_url, user, password)
    opener = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(mgr))
    try:
        with opener.open(ari_url + "/channels", timeout=5) as resp:
            return len(json.loads(resp.read()))
    except (urllib.error.URLError, OSError, ValueError):
        return None                                             # unknown


def in_window(spec, now=None):
    """spec 'HH-HH' in UTC (may wrap midnight); empty means always."""
    if not spec:
        return True
    start, end = (int(x) for x in spec.split("-"))
    hour = (now or dt.datetime.now(dt.timezone.utc)).hour
    return start <= hour < end if start < end else (hour >= start or hour < end)


def wait_for_quiet(host_env, window=True, patience=0):
    """Raise Busy unless it is the quiet window and no call is in progress (waiting up to `patience` seconds for the call)."""
    if window and not in_window(host_env.get("TREELINE_DEPLOY_WINDOW_UTC", "")):
        raise Busy("outside the deploy window (" + host_env.get("TREELINE_DEPLOY_WINDOW_UTC", "") + " UTC)")
    end = time.time() + patience
    while True:
        n = calls_in_progress()
        if n == 0:
            return
        if time.time() >= end:
            raise Busy("a call is in progress" if n else "could not ask Asterisk whether a call is in progress")
        time.sleep(5)


def health(version, seconds=HEALTH_SECONDS):
    """True once /api/health answers 200 AND reports `version` AND both services stay active for a few seconds."""
    end = time.time() + seconds
    last = ""
    good_since = None
    while time.time() < end:
        try:
            with urllib.request.urlopen(HEALTH_URL, timeout=5) as resp:
                body = json.loads(resp.read())
                ok = resp.status == 200 and body.get("ok") is True and body.get("release") == version
                last = f"200 release={body.get('release')}"
        except urllib.error.HTTPError as err:
            ok, last = False, f"HTTP {err.code}"
        except (urllib.error.URLError, OSError, ValueError) as err:
            ok, last = False, str(err)
        active = all(subprocess.run(["systemctl", "is-active", "--quiet", s]).returncode == 0 for s in SERVICES)
        if ok and active:
            good_since = good_since or time.time()
            if time.time() - good_since >= 5:
                return True
        else:
            good_since = None
        time.sleep(2)
    log(f"health check failed: {last}")
    return False


SOUNDS_DIR = "/usr/share/asterisk/sounds/en/treeline"
SOUND_NAME = re.compile(r"^[a-z0-9_]+\.wav$")


def build_sounds(release_dir):
    """The operator messages come from the release (asterisk/sounds): build them with the release's own script, as the
    unprivileged `treeline` user into a temporary folder, then copy only plain .wav files with plain names into Asterisk's
    folder. A deploy that adds or changes a message must not play a missing or stale file."""
    import tempfile
    script, src = os.path.join(release_dir, "asterisk", "make_sounds.sh"), os.path.join(release_dir, "asterisk", "sounds")
    if not os.path.isfile(script):
        return
    work = tempfile.mkdtemp(prefix="treeline-sounds-")
    try:
        shutil.chown(work, "treeline", "treeline")
        out = os.path.join(work, "out")
        done = subprocess.run(["runuser", "-u", "treeline", "--", "env", f"SOUNDS_SRC={src}", f"SOUNDS_OUT={out}", f"TMPDIR={work}",
                               "sh", script], capture_output=True, text=True, cwd=work)
        if done.returncode != 0:
            raise Failed("building the operator messages failed: " + done.stderr.strip()[-300:])
        os.makedirs(SOUNDS_DIR, exist_ok=True)
        for name in sorted(os.listdir(out)):
            path = os.path.join(out, name)
            if SOUND_NAME.match(name) and os.path.isfile(path) and not os.path.islink(path):
                shutil.copyfile(path, os.path.join(SOUNDS_DIR, name))
                os.chmod(os.path.join(SOUNDS_DIR, name), 0o644)
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ------------------------------------------------------------------ the Asterisk build that is running
def running_asterisk_id(proc="/proc"):
    """The build the running Asterisk process was started from, read from the process (/proc/<pid>/exe): state files say what was
    intended, only the process says what is running. None if Asterisk is not running."""
    done = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", "asterisk"], capture_output=True, text=True)
    pid = done.stdout.strip()
    if done.returncode != 0 or not pid.isdigit() or int(pid) == 0:
        return None
    try:
        exe = os.readlink(os.path.join(proc, pid, "exe"))
    except OSError:
        return None
    m = re.fullmatch(re.escape(common.ASTERISK_OPT) + "/(" + rel.ASTERISK_ID_RE.pattern + ")/sbin/asterisk", exe)
    return m.group(1) if m else None


def switch_asterisk(ast_id):
    """/usr/local/sbin/asterisk (what an operator types) follows the build that is meant to run."""
    rel.switch(common.ASTERISK_BIN, os.path.join(common.ASTERISK_OPT, ast_id, "sbin", "asterisk"))


def ari_get(path, etc=None, timeout=5):
    with open(os.path.join(etc or common.ETC, "ari-password"), encoding="utf-8") as f:
        password = f.read().strip()
    mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    mgr.add_password(None, "http://127.0.0.1:8088/ari", "treeline", password)
    opener = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(mgr))
    with opener.open("http://127.0.0.1:8088/ari" + path, timeout=timeout) as resp:
        return resp.status, resp.read()


def tls_port_open(port=5061):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=2):
            return True
    except OSError:
        return False


def asterisk_health(expect_id, seconds=60):
    """True once Asterisk is active, is running build `expect_id` (the process, not a file), answers ARI with its SIP stack loaded,
    and listens for SIP over TLS. Asterisk 'running' is not enough: it can be up and deaf (a module that failed to load)."""
    end = time.time() + seconds
    last = ""
    while time.time() < end:
        active = subprocess.run(["systemctl", "is-active", "--quiet", "asterisk"]).returncode == 0
        running = running_asterisk_id() if active else None
        try:
            ari = ari_get("/asterisk/modules/res_pjsip.so")[0] == 200
        except (urllib.error.URLError, OSError, ValueError):
            ari = False
        tls = tls_port_open()
        last = f"active={active} running={running} ari={ari} tls={tls}"
        if active and running == expect_id and ari and tls:
            return True
        time.sleep(2)
    log(f"Asterisk health check failed: {last}")
    return False


def systemctl(*args):
    subprocess.run(["systemctl", *args], check=True)


def restart(services):
    if services:
        systemctl("restart", *services)


# ------------------------------------------------------------------ config snapshots (for rollback)
CONFIG_FILES = ("/etc/caddy/Caddyfile", "/etc/treeline/app.env")


def snapshot_config(dest):
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest, mode=0o700)
    for f in CONFIG_FILES:
        if os.path.exists(f):
            shutil.copy2(f, os.path.join(dest, os.path.basename(f)))
    ast = os.path.join(dest, "asterisk")
    os.makedirs(ast, mode=0o700)
    for name in os.listdir("/etc/asterisk"):            # the files we render (plain files); not subdirectories such as keys/
        path = os.path.join("/etc/asterisk", name)
        if os.path.isfile(path) and not os.path.islink(path):
            shutil.copy2(path, os.path.join(ast, name))


def restore_config(src):
    for f in CONFIG_FILES:
        s = os.path.join(src, os.path.basename(f))
        if os.path.exists(s):
            shutil.copy2(s, f)
    ast = os.path.join(src, "asterisk")
    for name in os.listdir(ast):
        shutil.copy2(os.path.join(ast, name), os.path.join("/etc/asterisk", name))
    for name in os.listdir("/etc/asterisk"):          # what the failed release added (its asterisk-<id>.conf) goes; keys/ stays
        path = os.path.join("/etc/asterisk", name)
        if name.endswith(".conf") and not os.path.exists(os.path.join(ast, name)) and os.path.isfile(path) and not os.path.islink(path):
            os.remove(path)


# ------------------------------------------------------------------ data: refusing and undoing a rollback
_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


def open_data_dir(parts=(), create=False):
    """A descriptor for data/<parts...>, opened one component at a time with O_NOFOLLOW (R10-5). Root works inside a folder the
    `treeline` user owns, and that user can replace a folder with a link between two path lookups; a descriptor cannot be redirected.
    None if a component is missing (and `create` is False). Raises OSError (ELOOP/ENOTDIR) when a component is a link or not a folder."""
    fd = os.open(common.data_dir(), _DIR_FLAGS)
    try:
        for part in parts:
            if part in ("", ".", "..") or "/" in part:
                raise OSError(f"bad path component {part!r}")
            try:
                nxt = os.open(part, _DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    os.close(fd)
                    return None
                os.mkdir(part, 0o700, dir_fd=fd)
                nxt = os.open(part, _DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = nxt
    except BaseException:
        os.close(fd)
        raise
    return fd


def restore_data_from_pre_migrate(moved, expected, owner="treeline"):
    """The release that never became healthy migrated some files. The old code refuses a newer file (DATA_LAYER rule 3),
    so put back the copies the data layer took just before migrating, which are at the version the old code expects.
    Returns the files restored; raises Failed if any needed copy is missing (nothing is changed in that case).
    Every step goes through descriptors opened without following links (open_data_dir): a link planted by the app user in place of
    `households/` or `pre-migrate/` is refused, never followed as root."""
    plan = []
    for rel_path, version in moved.items():
        parts = tuple(os.path.dirname(rel_path).split("/")) if os.path.dirname(rel_path) else ()
        stem = os.path.basename(rel_path)[:-3] if rel_path != "treeline.db" else "treeline"
        pattern = re.compile(r"^" + re.escape(stem) + r"-v" + str(expected[rel_path]) + r"-(\d{8}T\d{6})-[0-9a-f]+\.db$")
        try:
            folder_fd = open_data_dir(parts + ("pre-migrate",))
        except OSError as err:
            raise Failed(f"the pre-migration folder for {rel_path} is not a plain folder ({err}); nothing was changed") from err
        try:
            found = sorted(n for n in (os.listdir(folder_fd) if folder_fd is not None else []) if pattern.match(n))
        finally:
            if folder_fd is not None:
                os.close(folder_fd)
        if not found:
            raise Failed(f"no pre-migration copy of {rel_path} at version {expected[rel_path]} in "
                         f"{os.path.join(common.data_dir(), *parts, 'pre-migrate')}")
        plan.append((rel_path, parts, found[-1]))
    for rel_path, parts, copy_name in plan:
        try:
            folder_fd = open_data_dir(parts + ("pre-migrate",))
            target_fd = open_data_dir(parts)
        except OSError as err:
            raise Failed(f"a data folder for {rel_path} is not a plain folder ({err})") from err
        try:
            if folder_fd is None or target_fd is None:
                raise Failed(f"a data folder for {rel_path} went missing")
            name = os.path.basename(rel_path)
            for suffix in ("", "-wal", "-shm"):
                try:
                    os.unlink(name + suffix, dir_fd=target_fd)            # a link is removed, never followed
                except FileNotFoundError:
                    pass
            src_fd = os.open(copy_name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=folder_fd)
            with os.fdopen(src_fd, "rb") as src:
                if not stat.S_ISREG(os.fstat(src.fileno()).st_mode):
                    raise Failed(f"{copy_name} is not a plain file")
                out_fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=target_fd)
                with os.fdopen(out_fd, "wb") as out:
                    shutil.copyfileobj(src, out)
                    if owner:
                        import pwd
                        pw = pwd.getpwnam(owner)
                        os.fchown(out.fileno(), pw.pw_uid, pw.pw_gid)
        finally:
            for fd in (folder_fd, target_fd):
                if fd is not None:
                    os.close(fd)
    return [p for p, _, _ in plan]


def plan_rollback(before, after, expected):
    """Split the files whose version the old code would refuse into: `moved` (they existed before the switch, so the data layer
    took a pre-migration copy) and `created` (made by the failed release, so there is no copy)."""
    wrong = {f: v for f, v in after.items() if v != expected[f]}
    return ({f: v for f, v in wrong.items() if f in before}, {f: v for f, v in wrong.items() if f not in before})


def quarantine_dir():
    return os.path.join(common.data_dir(), "quarantine", dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ"))


def quarantine(files):
    """Set aside, with its -wal/-shm, each file the failed release created. Descriptors, no links followed (R10-5): the source folder
    and the quarantine folder are opened without following links, and the move is a rename between those two descriptors."""
    stamp = os.path.basename(quarantine_dir())
    for rel_path in files:
        parts = tuple(os.path.dirname(rel_path).split("/")) if os.path.dirname(rel_path) else ()
        src_fd = open_data_dir(parts)
        if src_fd is None:
            continue
        try:
            dst_fd = open_data_dir(("quarantine", stamp) + parts, create=True)
            try:
                name = os.path.basename(rel_path)
                for suffix in ("", "-wal", "-shm"):
                    try:
                        os.rename(name + suffix, name + suffix, src_dir_fd=src_fd, dst_dir_fd=dst_fd)
                    except FileNotFoundError:
                        pass
            finally:
                os.close(dst_fd)
        finally:
            os.close(src_fd)


def schema_of(release_dir):
    try:
        return rel.read_info(release_dir, ci=True)["schema"]
    except rel.ReleaseError as err:
        raise Refused(f"{release_dir}: {err}") from err


def expected_versions(files, schema):
    return {f: (schema["central"] if f == "treeline.db" else schema["household"]) for f in files}


# ------------------------------------------------------------------ the deploy
def stage(tarball, sig, version, p, host_env, signers=None):
    """Verify, unpack, check and prepare a release, and install its Asterisk build beside the others. Nothing is switched.
    Returns its directory."""
    ci = is_ci(host_env)
    os.makedirs(p["releases"], exist_ok=True)
    mine = os.path.join(p["releases"], f".verified-{os.getpid()}")
    shutil.rmtree(mine, ignore_errors=True)
    try:
        # R10-7: one private copy is both verified and unpacked, so nothing can change between the two.
        if not os.path.isfile(sig):
            raise rel.ReleaseError(f"no signature file {sig}")
        tarball, sig = rel.private_copy(tarball, mine), rel.private_copy(sig, mine)
        rel.verify(tarball, sig, signers or rel.signers_file())
    except rel.ReleaseError as err:
        shutil.rmtree(mine, ignore_errors=True)
        raise Refused(str(err)) from err
    log("signature verified")
    try:
        return _stage_verified(tarball, version, p, ci)
    finally:
        shutil.rmtree(mine, ignore_errors=True)


def _stage_verified(tarball, version, p, ci):
    tmp = os.path.join(p["releases"], f".staging-{os.getpid()}")
    shutil.rmtree(tmp, ignore_errors=True)
    try:
        rel.extract(tarball, tmp)
        info = rel.read_info(tmp, ci=ci)
    except rel.ReleaseError as err:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Refused(str(err)) from err
    try:
        if version and info["version"] != version:
            # A genuine, signed, OLD release served under a new name (a replay) would pass the signature check.
            raise Refused(f"the release says it is {info['version']}, not {version}")
        dest = os.path.join(p["releases"], info["version"])
        if os.path.exists(dest):
            raise Refused(f"{info['version']} is already installed")
        os.rename(tmp, dest)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    created = False
    checks_began = False
    try:
        rel.build_venv(dest)         # needs the network (pip): a failure here is not marked, so the next timer run tries again
        checks_began = True
        rel.seal(dest)
        # Only from the sealed release directory, whose signature has been checked: the build is read once, hashed against
        # release.json, validated, unpacked by our own code, and compared with what is on disk if it is already there.
        created = rel.install_asterisk(dest, opt=common.ASTERISK_OPT, ci=ci)
        preflight(dest, ci=ci)
    except BaseException as err:     # R10-2: anything at all (a hung `asterisk -V`, a short ELF, a missing modules.txt) leaves nothing behind
        shutil.rmtree(dest, ignore_errors=True)
        if created:
            shutil.rmtree(os.path.join(common.ASTERISK_OPT, info["asterisk"]["id"]), ignore_errors=True)
        if not isinstance(err, Exception):
            raise                    # Ctrl-C, SystemExit: cleaned up above, not turned into a refusal
        if checks_began:
            # R10-3: a release that fails its own checks fails the same way on every timer run (a download, a pip install, a build
            # each time), so it is recorded like a release that failed its health check: only an explicit --version retries it.
            try:
                mark_failed(p, info["version"])
            except Exception as again:   # noqa: BLE001
                log(f"could not record that {info['version']} failed its checks: {again}")
        raise Refused(f"{info['version']} failed its own checks: {type(err).__name__}: {err}") from err
    return dest


def modules_of(release_dir):
    """The module names the release says its Asterisk contains (asterisk/build/modules.txt)."""
    with open(os.path.join(release_dir, "asterisk", "build", "modules.txt"), encoding="utf-8") as f:
        return sorted(l.strip() for l in f if l.strip() and not l.lstrip().startswith("#"))


def smoke_asterisk(tree, ast_id, run=subprocess.run):
    """`asterisk -V` as the asterisk user (never as root: it runs code from the release), with an empty environment."""
    done = run(["runuser", "-u", common.ASTERISK_USER, "--", "env", "-i", "PATH=/usr/bin:/bin",
                os.path.join(tree, "sbin", "asterisk"), "-V"], capture_output=True, text=True, cwd="/", timeout=30)
    want = "Asterisk " + re.sub(r"-[tx]\d+$", "", ast_id)
    if done.returncode != 0 or done.stdout.strip() != want:
        raise Failed(f"asterisk -V said {done.stdout.strip()!r} {done.stderr.strip()[-200:]!r}, not {want!r}")


def check_asterisk(release_dir, info, ci=False, run=subprocess.run):
    """The release's own Asterisk build is installed exactly as the release made it, links only to what exists, starts, and has exactly
    the modules the release says. Refuse before anything is stopped, switched or restarted."""
    ast_id = info["asterisk"]["id"]
    tree = os.path.join(common.ASTERISK_OPT, ast_id)
    try:
        rel.verify_asterisk_tree(tree, release_dir, info, ci=ci)
        rel.check_elf_needs(tree, ast_id)
    except rel.ReleaseError as err:
        raise Failed(str(err)) from err
    smoke_asterisk(tree, ast_id, run=run)
    modules = os.path.join(tree, "lib", "asterisk", "modules")
    have = sorted(n[:-3] for n in os.listdir(modules) if n.endswith(".so"))
    if have != modules_of(release_dir):
        raise Failed(f"the installed modules differ from the release's modules.txt: {sorted(set(have) ^ set(modules_of(release_dir)))[:5]}")


def preflight(release_dir, ci=False):
    """The new release's own claims, checked with its own code, before anything is touched."""
    info = rel.read_info(release_dir, ci=ci)
    check_asterisk(release_dir, info, ci=ci)
    py = os.path.join(release_dir, "venv", "bin", "python")
    code = ("import json, sys\n"
            "sys.path.insert(0, 'controller')\n"
            "from treeline import db, households, rules, accesslog, prod, api, calls, jobs\n"
            "print(json.dumps({'central': len(db.MIGRATIONS) + 1, 'household': len(households.HOUSEHOLD_MIGRATIONS) + 1}))\n")
    # The import runs with the machine's real settings: the new code is production (release.json), so it checks them too.
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
    for f in (os.path.join(common.ETC, "app.env"), os.path.join(common.RUN, "env")):
        if os.path.exists(f):
            env.update({k: v.replace('\\"', '"').replace("\\\\", "\\") for k, v in common.read_env_file(f).items()})
    done = subprocess.run(["runuser", "-u", "treeline", "--", py, "-I", "-c", code], capture_output=True, text=True, cwd=release_dir, env=env)
    if done.returncode != 0:
        raise Failed("the code does not import: " + done.stderr.strip()[-400:])
    if json.loads(done.stdout) != info["schema"]:
        raise Failed(f"release.json says schema {info['schema']} but the code says {json.loads(done.stdout)}")
    # Dry-run the configuration with the release's templates: a template error must not reach /etc.
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("treeline_config", os.path.join(os.path.dirname(os.path.realpath(__file__)), "treeline-config"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    cfg = importlib.util.module_from_spec(spec)
    loader.exec_module(cfg)
    s = cfg.settings()
    cfg.asterisk_files(release_dir, s)
    cfg.app_env(release_dir, s)
    caddy = cfg.caddyfile(release_dir, s)
    tmp = os.path.join(common.RUN, "Caddyfile.check")
    common.atomic_write(tmp, caddy, 0o600)
    try:
        done = subprocess.run(["caddy", "validate", "--config", tmp, "--adapter", "caddyfile"], capture_output=True, text=True)
        if done.returncode != 0:
            raise Failed("the new Caddyfile is invalid: " + done.stderr.strip()[-300:])
    finally:
        os.remove(tmp)


def config_tool():
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "treeline-config")


def previous_asterisk(prev_dir):
    """The previous release's build id, with its tree verified NOW, before anything is stopped or switched: a rollback to a build that
    has gone missing or been changed would fail at the worst moment."""
    ast_id = rel.release_asterisk_id(prev_dir)
    if not ast_id:
        raise Refused(f"the running release ({os.path.basename(prev_dir)}) does not name an Asterisk build (an old release format), "
                      "so there would be nothing to roll back to. Nothing was changed. Install a release of this format by hand "
                      "(docs/DEPLOY_AWS.md).")
    ci = is_ci(common.host_settings())      # R10-6: a test id (-x<n>) in the running release is accepted only in the CI job, as everywhere else
    try:
        rel.verify_asterisk_tree(os.path.join(common.ASTERISK_OPT, ast_id), prev_dir, rel.read_info(prev_dir, ci=ci), ci=ci)
    except rel.ReleaseError as err:
        raise Refused(f"the running release's Asterisk build is not intact, so a rollback would not work: {err}") from err
    return ast_id


def inflight_path(p):
    return os.path.join(p["state"], "inflight.json")


def set_inflight(p, **what):
    os.makedirs(p["state"], mode=0o700, exist_ok=True)
    common.atomic_write(inflight_path(p), json.dumps(what), 0o600)


def clear_inflight(p):
    try:
        os.remove(inflight_path(p))
    except FileNotFoundError:
        pass


def recover(p):
    """Under the lock, at the start of every run: a deploy that was killed between writing the configuration and finishing the
    restart (the journal is still there) left a configuration for one release and a process of another. Make the machine whole
    again for whichever release the `current` link names: its configuration, its units, its build."""
    if not os.path.exists(inflight_path(p)):
        return
    cur = current_version(p)
    log(f"a deploy was interrupted ({read_json(inflight_path(p))}); putting the machine back in step with {cur}")
    if cur:
        cur_dir = os.path.join(p["releases"], cur)
        ast_id = rel.release_asterisk_id(cur_dir)
        done = subprocess.run([config_tool(), "apply", "--release", cur_dir], capture_output=True, text=True)
        if done.returncode != 0:
            raise Failed("could not re-render the configuration of the current release: " + done.stderr.strip()[-300:])
        if ast_id:
            switch_asterisk(ast_id)
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        # R10-1: a deploy or rollback stops the app's services before it starts them again, and a kill in between leaves them stopped
        # (systemd does not restart a unit that was stopped on purpose). Start them, and restart what the re-render changed.
        changed = set(done.stdout.replace("changed:", "").replace(",", " ").split()) - {"nothing", "app"}
        restart_ast = bool(ast_id) and (running_asterisk_id() != ast_id or "asterisk" in changed)
        restart([u for u in ("asterisk", "caddy") if (u == "asterisk" and restart_ast) or (u == "caddy" and u in changed)])
        restart(SERVICES)
        if not health(cur):
            log(f"{cur} is not healthy after recovery; the next run will say more")
    clear_inflight(p)


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def deploy(dest, p, host_env, prev_version, patience=0, window=True, allow_older=False):
    """Switch to the staged release at `dest`; roll back if it does not become healthy."""
    ci = is_ci(host_env)
    info = rel.read_info(dest, ci=ci)
    new, new_ast = info["version"], info["asterisk"]["id"]
    if prev_version and not allow_older and vkey(new) <= vkey(prev_version):
        shutil.rmtree(dest, ignore_errors=True)
        raise Refused(f"{new} is not newer than the running {prev_version}")
    prev_dir = os.path.join(p["releases"], prev_version) if prev_version else None
    try:
        prev_ast = previous_asterisk(prev_dir) if prev_dir else None
        wait_for_quiet(host_env, window=window, patience=patience)
        before = data_versions()
    except BaseException:
        shutil.rmtree(dest, ignore_errors=True)      # nothing was switched: do not leave a staged release that blocks the retry
        raise
    snap = os.path.join(p["state"], "config-before")
    os.makedirs(p["state"], mode=0o700, exist_ok=True)
    snapshot_config(snap)
    log(f"switching {prev_version} -> {new} (Asterisk {prev_ast} -> {new_ast})")
    changed = {"asterisk", "caddy"}          # until we know better, assume the worst for a rollback's restarts
    running_before = running_asterisk_id()
    set_inflight(p, **{"from": prev_version, "to": new, "from_asterisk": prev_ast, "to_asterisk": new_ast})
    try:
        done = subprocess.run([config_tool(), "apply", "--release", dest], capture_output=True, text=True)
        if done.returncode != 0:
            raise Failed("treeline-config failed: " + done.stderr.strip()[-300:])
        changed = set(done.stdout.replace("changed:", "").replace(",", " ").split()) - {"nothing", "app"}
        build_sounds(dest)
        rel.switch(p["current"], dest)
        switch_asterisk(new_ast)
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        # Asterisk is restarted when it is not running the new build (read from the process) or its configuration changed.
        restart_ast = running_before != new_ast or "asterisk" in changed
        restart([u for u in ("asterisk", "caddy") if (u == "asterisk" and restart_ast) or (u == "caddy" and u in changed)])
        restart(SERVICES)
        if not (health(new) and (not restart_ast or asterisk_health(new_ast))):
            raise Failed(f"{new} did not become healthy")
        record(p, current=new, previous=prev_version, schema_before=before, schema_new=info["schema"],
               asterisk=new_ast, asterisk_previous=prev_ast)
        clear_failed(p, new)
    except Exception as err:        # noqa: BLE001 -- anything at all after the switch begins means we go back
        log(f"FAILED: {err}")
        code = roll_back(p, prev_dir, prev_version, snap, before, changed, failed_dir=dest, prev_ast=prev_ast)
        clear_inflight(p)
        return code
    clear_inflight(p)
    try:                         # tidying up never turns a healthy deploy into a failed one
        prune(p, keep={new, prev_version})
    except Exception as err:     # noqa: BLE001
        log(f"could not remove old releases (the deploy itself succeeded): {err}")
    log(f"{new} is healthy")
    return 0


def roll_back(p, prev_dir, prev_version, snap, before, changed, failed_dir=None, prev_ast=None):
    if not prev_dir:
        log("there is no previous release to go back to")
        return 5
    try:
        prev_ast = prev_ast or rel.release_asterisk_id(prev_dir)
        for s in SERVICES:
            subprocess.run(["systemctl", "stop", s], check=False)
        after = data_versions()
        old_schema = schema_of(prev_dir)
        expected = expected_versions(after, old_schema)
        moved, created = plan_rollback(before, after, expected)
        if created:
            # Made while the failed release ran (a family created during the health wait), at a version the old code refuses,
            # and with no pre-migration copy. Set aside, not lost, so everyone else gets the old release back.
            log(f"files created by the failed release at a newer version: {sorted(created)}; moving them to {quarantine_dir()}")
            quarantine(created)
        if moved:
            log(f"the failed release migrated {sorted(moved)}; restoring the copies taken just before")
            restore_data_from_pre_migrate(moved, expected)
        restore_config(snap)
        # The old release's own files for Asterisk (its build's asterisk.conf, its unit and drop-in) are rendered again, not
        # restored from a copy: a restored byte-copy of a drop-in that names one build beside a unit that names another would not run.
        done = subprocess.run([config_tool(), "apply", "--release", prev_dir], capture_output=True, text=True)
        if done.returncode != 0:
            raise Failed("treeline-config failed for the previous release: " + done.stderr.strip()[-300:])
        build_sounds(prev_dir)
        rel.switch(p["current"], prev_dir)
        if prev_ast:
            switch_asterisk(prev_ast)
        subprocess.run(["systemctl", "daemon-reload"], check=True)
        restart_ast = "asterisk" in changed or (prev_ast is not None and running_asterisk_id() != prev_ast)
        restart([u for u in ("asterisk", "caddy") if (u == "asterisk" and restart_ast) or (u == "caddy" and u in changed)])
        restart(SERVICES)
        if health(prev_version) and (not restart_ast or not prev_ast or asterisk_health(prev_ast)):
            log(f"ROLLED BACK to {prev_version}, which is healthy")
            if failed_dir:
                mark_failed(p, os.path.basename(failed_dir))
                shutil.rmtree(failed_dir, ignore_errors=True)       # so a fixed build of it can be deployed with --version
            try:
                prune_asterisk(p)                                    # the failed release's build is not needed any more
            except Exception as err:    # noqa: BLE001
                log(f"could not remove the failed release's Asterisk build: {err}")
            return 1
        log(f"ROLLBACK FAILED: {prev_version} is not healthy either")
        return 5
    except Exception as err:        # noqa: BLE001
        log(f"ROLLBACK FAILED: {err}")
        return 5


def record(p, **state):
    """Update state.json (the keys given replace the old ones; the rest, such as the list of failed releases, is kept)."""
    merged = read_state(p)
    merged.update(state)
    merged["at"] = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    os.makedirs(p["state"], mode=0o700, exist_ok=True)
    common.atomic_write(os.path.join(p["state"], "state.json"), json.dumps(merged, indent=2), 0o600)


def mark_failed(p, version):
    """A release that did not become healthy is not tried again by the timer (it would fail, and cause an outage, every
    15 minutes of the window). Only an explicit --version retries it."""
    failed = sorted(set(read_state(p).get("failed", [])) | {version}, key=vkey)
    record(p, failed=failed)


def clear_failed(p, version):
    failed = [v for v in read_state(p).get("failed", []) if v != version]
    record(p, failed=failed)


def read_state(p):
    try:
        with open(os.path.join(p["state"], "state.json"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def prune(p, keep):
    versions = installed(p)
    for v in versions[:-KEEP_RELEASES]:
        if v not in keep:
            shutil.rmtree(os.path.join(p["releases"], v), ignore_errors=True)
    prune_asterisk(p)


def prune_asterisk(p):
    """Remove Asterisk builds that no remaining release carries and that are not running. If any remaining release cannot be read, what
    it needs is unknown, so nothing is removed."""
    keep = set()
    for v in installed(p):
        ast_id = rel.release_asterisk_id(os.path.join(p["releases"], v))
        if ast_id is None:
            return []
        keep.add(ast_id)
    running = running_asterisk_id()
    if running:
        keep.add(running)
    return rel.sweep_asterisk(common.ASTERISK_OPT, keep=keep)


def manual_rollback(p):
    state = read_state(p)
    prev, cur = state.get("previous"), current_version(p)
    if not cur:
        raise Refused("no release is current on this machine (the current link is missing), so there is nothing to roll back from")
    if not prev or not os.path.isdir(os.path.join(p["releases"], prev)):
        raise Refused("there is no previous release on this machine")
    prev_dir, cur_dir = os.path.join(p["releases"], prev), os.path.join(p["releases"], cur)
    now = data_versions()
    expected = expected_versions(now, schema_of(prev_dir))
    moved = sorted(f for f, v in now.items() if v != expected[f])
    if moved:
        raise Refused(f"cannot roll back from {cur} to {prev}: {moved} are at a newer data version than {prev} understands, and "
                      "families have written to them since. Restore from a backup and a pre-migration copy by hand (docs/DEPLOY_AWS.md, rollback).")
    prev_ast = previous_asterisk(prev_dir)          # verified before anything is stopped
    cur_ast = rel.release_asterisk_id(cur_dir)
    wait_for_quiet(common.host_settings(), window=False)
    snap = os.path.join(p["state"], "config-before")
    os.makedirs(p["state"], mode=0o700, exist_ok=True)
    snapshot_config(snap)
    log(f"rolling back {cur} -> {prev} (Asterisk {cur_ast} -> {prev_ast})")
    set_inflight(p, **{"from": cur, "to": prev, "from_asterisk": cur_ast, "to_asterisk": prev_ast})
    for s in SERVICES:
        subprocess.run(["systemctl", "stop", s], check=False)
    try:
        rel.switch(p["current"], prev_dir)
        switch_asterisk(prev_ast)
        done = subprocess.run([config_tool(), "apply", "--release", prev_dir, "--restart"], capture_output=True, text=True)
        if done.returncode != 0:
            raise Failed("treeline-config failed for the previous release: " + done.stderr.strip()[-300:])
        build_sounds(prev_dir)
        if running_asterisk_id() != prev_ast:           # apply restarts only what changed: the process must be the right build
            subprocess.run(["systemctl", "restart", "asterisk"], check=True)
        restart(SERVICES)
        if not (health(prev) and asterisk_health(prev_ast)):
            raise Failed(f"{prev} did not become healthy")
    except Exception as err:        # noqa: BLE001 -- never leave the services stopped: go back to what was running
        log(f"ROLLBACK FAILED: {err}; going back to {cur}")
        try:
            restore_config(snap)
            subprocess.run([config_tool(), "apply", "--release", cur_dir], capture_output=True, text=True, check=True)
            rel.switch(p["current"], cur_dir)
            if cur_ast:
                switch_asterisk(cur_ast)
            subprocess.run(["systemctl", "daemon-reload"], check=False)
            subprocess.run(["systemctl", "restart", "asterisk", "caddy"], check=False)
            subprocess.run(["systemctl", "restart", *SERVICES], check=False)
            build_sounds(cur_dir)
        except Exception as again:  # noqa: BLE001
            log(f"could not go back to {cur} either: {again}")
            return 5
        clear_inflight(p)
        return 5 if not health(cur) else 1
    record(p, current=prev, previous=cur, schema_before=now, schema_new=schema_of(prev_dir), asterisk=prev_ast, asterisk_previous=cur_ast)
    clear_inflight(p)
    return 0


# ------------------------------------------------------------------ commands
def take_lock(p):
    """The one lock every change to the installed releases and builds goes through (a deploy, a rollback, adopt, install-asterisk)."""
    os.makedirs(os.path.dirname(p["run"]), exist_ok=True)
    lock = open(p["run"], "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        raise Busy("another deploy is running") from None
    return lock


def legacy_release(p, version):
    """`version` if the installed release of that name is a format-1 release (made before releases carried their own Asterisk, the
    ones that ran on Ubuntu's package), else None. Read as plain JSON: this agent's read_info refuses such a release by design."""
    if version == "" or not rel.VERSION_RE.match(version):
        return None
    try:
        with open(os.path.join(p["releases"], version, "release.json"), encoding="utf-8") as f:
            info = json.load(f)
    except (OSError, ValueError):
        return None
    if isinstance(info, dict) and info.get("version") == version and type(info.get("format")) is int and info["format"] == 1:
        return version
    return None


def adopt(src):
    """Stage the release install.sh was run from, ONLY on a machine with no release yet, or one whose release is format 1 (the
    one-time move off Ubuntu's Asterisk package). Afterwards releases change only through the agent (verified, health-checked, with
    rollback); re-running an old install.sh must never switch production back."""
    p = paths()
    host_env = common.host_settings()
    ci = is_ci(host_env)
    with take_lock(p):
        legacy = None
        if current_version(p):
            legacy = legacy_release(p, current_version(p))
            if not legacy:
                print(f"a release is already installed ({current_version(p)}); install.sh does not change it (use treeline-deploy)")
                return 0
            log(f"{legacy} is a format-1 release (it carries no Asterisk build of its own); this install replaces it. It cannot be rolled back "
                "to: this agent refuses format-1 releases.")
        rel.sweep_leftovers(common.ASTERISK_OPT)
        info = rel.read_info(src, ci=ci)
        dest = os.path.join(p["releases"], info["version"])
        if os.path.exists(dest):
            raise SystemExit(f"{dest} already exists")
        os.makedirs(p["releases"], exist_ok=True)
        shutil.copytree(src, dest, symlinks=True)
        try:
            rel.build_venv(dest)
            rel.seal(dest)
            rel.install_asterisk(dest, opt=common.ASTERISK_OPT, ci=ci)
        except BaseException:
            shutil.rmtree(dest, ignore_errors=True)
            raise
        rel.switch(p["current"], dest)
        switch_asterisk(info["asterisk"]["id"])
        os.makedirs(p["state"], mode=0o700, exist_ok=True)
        record(p, current=info["version"], previous=None, asterisk=info["asterisk"]["id"], asterisk_previous=None)
        if legacy:        # nothing can go back to it, and a release this agent cannot read would stop old builds from being pruned
            shutil.rmtree(os.path.join(p["releases"], legacy), ignore_errors=True)
        print(f"staged {info['version']} with Asterisk {info['asterisk']['id']}" + (f" (replacing {legacy})" if legacy else ""))
    return 0


def install_asterisk_cmd(directory):
    """Install, or check, the Asterisk build of an installed release (install.sh runs this on every run, before Ubuntu's package is
    removed): the same installer the deploy uses, under the same lock, and the same checks, including starting `asterisk -V`."""
    p = paths()
    host_env = common.host_settings()
    ci = is_ci(host_env)
    real = os.path.realpath(directory)
    if os.path.dirname(real) != os.path.realpath(p["releases"]) or not rel.VERSION_RE.match(os.path.basename(real)):
        raise Refused(f"{directory} is not an installed release (only /opt/treeline/releases/<version> is accepted)")
    with take_lock(p):
        rel.sweep_leftovers(common.ASTERISK_OPT)
        info = rel.read_info(real, ci=ci)
        created = rel.install_asterisk(real, opt=common.ASTERISK_OPT, ci=ci)
        try:
            check_asterisk(real, info, ci=ci)
        except Failed:
            if created:
                shutil.rmtree(os.path.join(common.ASTERISK_OPT, info["asterisk"]["id"]), ignore_errors=True)
            raise
        switch_asterisk(info["asterisk"]["id"])
        print(f"Asterisk {info['asterisk']['id']} is installed and checked" + (" (new)" if created else ""))
    return 0


def run(argv):
    if len(argv) == 2 and argv[0] == "adopt":
        return adopt(os.path.realpath(argv[1]))
    if len(argv) == 2 and argv[0] == "install-asterisk":
        return install_asterisk_cmd(argv[1])
    p = paths()
    host_env = common.host_settings()
    opts = {"--version": None, "--tarball": None, "--sig": None, "--rollback": False, "--force": False, "--wait": None}
    it = iter(argv)
    for a in it:
        if a == "releases":
            print(json.dumps(releases_report(p, host_env)))
            return 0
        if a == "status":
            cur = current_version(p)
            print(json.dumps({"current": cur, "installed": installed(p), "state": read_state(p),
                              "asterisk": {"running": running_asterisk_id(),
                                           "current_release_carries": rel.release_asterisk_id(os.path.join(p["releases"], cur)) if cur else None,
                                           "builds": sorted(n for n in (os.listdir(common.ASTERISK_OPT) if os.path.isdir(common.ASTERISK_OPT) else [])
                                                            if rel.ASTERISK_ID_RE.fullmatch(n))}}, indent=2))
            return 0
        if a not in opts:
            print(__doc__)
            return 2
        opts[a] = True if isinstance(opts[a], bool) else next(it, None)
    with take_lock(p):
        rel.sweep_leftovers(common.ASTERISK_OPT)
        if os.path.isdir(p["releases"]):          # what a killed run left: its private copy and its half-unpacked release
            for n in os.listdir(p["releases"]):
                if n.startswith((".verified-", ".staging-")):
                    shutil.rmtree(os.path.join(p["releases"], n), ignore_errors=True)
        recover(p)
        if opts["--rollback"]:
            return manual_rollback(p)
        auto = not (opts["--version"] or opts["--tarball"])
        cur = current_version(p)
        with_dir = os.path.join(p["releases"], ".download")
        shutil.rmtree(with_dir, ignore_errors=True)
        os.makedirs(with_dir, mode=0o700)
        try:
            if opts["--tarball"]:
                tarball, sig, version = opts["--tarball"], opts["--sig"] or opts["--tarball"] + ".sig", opts["--version"]
            else:
                version = opts["--version"] or latest_version(host_env)
                if auto and cur and vkey(version) <= vkey(cur):
                    log(f"{cur} is the latest; nothing to do")
                    return 0
                if auto and version in read_state(p).get("failed", []):
                    log(f"{version} failed its health check before and was rolled back; not trying it again on the timer "
                        f"(publish a newer release, or run: treeline-deploy --version {version})")
                    return 0
                if auto:
                    wait_for_quiet(host_env, window=True)        # do not even download outside the window
                tarball, sig = fetch_release(version, with_dir, host_env)
            dest = stage(tarball, sig, version, p, host_env)
            return deploy(dest, p, host_env, cur, patience=int(opts["--wait"] or 0), window=auto, allow_older=bool(opts["--force"]))
        finally:
            shutil.rmtree(with_dir, ignore_errors=True)


def main(argv):
    try:
        return run(argv)
    except Refused as err:
        log(f"REFUSED: {err}")
        return 3
    except Busy as err:
        log(f"not now: {err}")
        return 4
    except (Failed, rel.ReleaseError) as err:
        log(f"FAILED: {err}")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
