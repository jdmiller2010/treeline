#!/opt/treeline/tools/bin/python -I
"""Fetch the secrets the app needs from SSM Parameter Store into a tmpfs file, as the service starts.

    treeline-fetch-secrets [--out /run/treeline/env]

Run by systemd (ExecStartPre=+, as root) before the API and the controller. The file is KEY="value" lines for
systemd's EnvironmentFile, mode 0600, on /run (tmpfs), replaced atomically. Nothing is written anywhere else,
logged, or put on a command line. The ARI password is not in SSM: the installer generated it on this machine
(/etc/treeline/ari-password). A missing parameter is a hard failure: the app must not start half-configured.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import treeline_common as common  # noqa: E402

# SSM name (under /treeline/) -> environment variable
PARAMS = {
    "smtp_user": "TREELINE_SMTP_USER",
    "smtp_password": "TREELINE_SMTP_PASS",
    "vapid_public": "TREELINE_VAPID_PUBLIC",
    "vapid_private": "TREELINE_VAPID_PRIVATE",
}
PREFIX = "/treeline"


def client(etc=None, region=None):
    """A boto3 SSM client using only the VM user's key file. TREELINE_AWS_ENDPOINT (a file in /etc/treeline written by
    `install.sh --ci`) points it at a fake, for the CI job that imitates the VM; production never has that file."""
    import boto3
    etc = etc or common.ETC
    os.environ["AWS_SHARED_CREDENTIALS_FILE"] = os.path.join(etc, "aws-credentials")
    os.environ["AWS_CONFIG_FILE"] = os.devnull
    os.environ.pop("AWS_PROFILE", None)
    kwargs = {"region_name": region or common.host_settings(etc).get("TREELINE_AWS_REGION", "us-west-2")}
    endpoint = os.path.join(etc, "aws-endpoint")
    if os.path.exists(endpoint):
        kwargs["endpoint_url"] = open(endpoint, encoding="utf-8").read().strip()
    session = boto3.session.Session(profile_name="treeline-vm")
    return session.client("ssm", **kwargs)


def fetch(ssm, params=PARAMS):
    names = [f"{PREFIX}/{n}" for n in params]
    got = ssm.get_parameters(Names=names, WithDecryption=True)
    missing = list(got.get("InvalidParameters", [])) + [n for n in names if n not in {p["Name"] for p in got["Parameters"]}]
    if missing:
        raise SystemExit("missing SSM parameter(s): " + ", ".join(sorted(set(missing))) + " (run infra/bootstrap/bootstrap.sh check)")
    values = {p["Name"][len(PREFIX) + 1:]: p["Value"] for p in got["Parameters"]}
    return {params[n]: values[n] for n in params}


def env_line(key, value):
    if "\n" in value or "\r" in value or "\0" in value:
        raise SystemExit(f"{key}: value has a line break; refusing to write it")
    return f'{key}="' + value.replace("\\", "\\\\").replace('"', '\\"') + '"\n'


def build(ssm, etc=None):
    etc = etc or common.ETC
    env = fetch(ssm)
    with open(os.path.join(etc, "ari-password"), encoding="utf-8") as f:
        env["ARI_PASS"] = f.read().strip()
    if not env["ARI_PASS"]:
        raise SystemExit("/etc/treeline/ari-password is empty (re-run install.sh)")
    return "".join(env_line(k, env[k]) for k in sorted(env))


def main(argv):
    out = os.path.join(common.RUN, "env")
    if "--out" in argv:
        out = argv[argv.index("--out") + 1]
    text = build(client())
    os.umask(0o077)
    common.atomic_write(out, text, mode=0o600)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
