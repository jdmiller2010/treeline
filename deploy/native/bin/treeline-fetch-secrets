#!/opt/treeline/tools/bin/python -I
"""Fetch the secrets the app needs from SSM Parameter Store into a tmpfs file, as the service starts.

    treeline-fetch-secrets [--out /run/treeline/env]

Run by systemd (ExecStartPre=+, as root) before the API and the controller. The file is KEY="value" lines for
systemd's EnvironmentFile, mode 0600, on /run (tmpfs), replaced atomically. Nothing is written anywhere else,
logged, or put on a command line. The ARI password is not in SSM: the installer generated it on this machine
(/etc/treeline/ari-password). A missing parameter is a hard failure: the app must not start half-configured.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import treeline_common as common  # noqa: E402

import grp  # noqa: E402

import treeline_aws as aws  # noqa: E402

# SSM name (under /treeline/) -> environment variable, per profile
PARAMS = {
    "smtp_user": "TREELINE_SMTP_USER",
    "smtp_password": "TREELINE_SMTP_PASS",
    "vapid_public": "TREELINE_VAPID_PUBLIC",
    "vapid_private": "TREELINE_VAPID_PRIVATE",
}
BACKUP_PARAMS = {"backup_age_recipient": "TREELINE_BACKUP_RECIPIENT", "backup_bucket": "TREELINE_BACKUP_BUCKET"}   # neither is secret


def client(etc=None, region=None):
    return aws.client("ssm", etc=etc, region=region)


def fetch(ssm, params=PARAMS):
    return aws.fetch(ssm, params)


def env_line(key, value):
    if "\n" in value or "\r" in value or "\0" in value:
        raise SystemExit(f"{key}: value has a line break; refusing to write it")
    return f'{key}="' + value.replace("\\", "\\\\").replace('"', '\\"') + '"\n'


def build(ssm, etc=None):
    etc = etc or common.ETC
    env = fetch(ssm)
    with open(os.path.join(etc, "ari-password"), encoding="utf-8") as f:
        env["ARI_PASS"] = f.read().strip()
    if not env["ARI_PASS"]:
        raise SystemExit("/etc/treeline/ari-password is empty (re-run install.sh)")
    return "".join(env_line(k, env[k]) for k in sorted(env))


def main(argv):
    def opt(name, default):
        return argv[argv.index(name) + 1] if name in argv else default
    profile, out = opt("--profile", "app"), opt("--out", os.path.join(common.RUN, "env"))
    mode, group = int(opt("--mode", "0600"), 8), opt("--group", None)
    if profile == "backup":
        text = "".join(env_line(k, v) for k, v in sorted(fetch(client(), BACKUP_PARAMS).items()))
    elif profile == "app":
        text = build(client())
    else:
        raise SystemExit("unknown profile")
    os.umask(0o077)
    common.atomic_write(out, text, mode=mode, gid=grp.getgrnam(group).gr_gid if group else None)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
