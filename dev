#!/usr/bin/env bash
# One entry point for developing Treeline, so the same mistakes don't happen twice.
#
#   ./dev up                 build and start the stack (needed after requirements/Dockerfile changes)
#   ./dev restart            pick up Python changes (the source is mounted; no rebuild)
#   ./dev unit [module]      unit tests (never touch the dev database)
#   ./dev sip [scenario...]  scripted SIP phones (real calls)
#   ./dev web [script.py]    browser tablets on real calls: phone_calls.py (default), phone_ui.py
#   ./dev ui start|stop|status|reset|smoke|pwa   a local API on a throwaway database, the parent-app browser test, and the installable-app test
#   ./dev native             tests for the VM's tools (deploy/native/tests): secrets, certificates, configuration, releases, the deploy agent's logic
#   ./dev vm                 the VM-imitating job: install.sh and the deploy agent in a systemd container (about 10 minutes; needs privileged Docker)
#   ./dev infra              the bootstrap.sh and deploy.sh tests (against a fake aws), in a container that has jq
#   ./dev cdk                the CDK app's template assertions and a real `cdk synth` (needs the one-time setup in infra/README.md)
#   ./dev check              regenerate generated files, check syntax and the repo rules, fail if anything was stale
#   ./dev rules [args]       scan the repo for secrets, addresses and other things that must not be public (docs/REPO_RULES.md)
#   ./dev hooks              turn on the pre-commit hook that runs those rules on every commit
#   ./dev sbom [args]        the bill of materials: every third-party thing we run, build with or ship (--table to read it; docs/SUPPLY_CHAIN.md)
#   ./dev vulns [--os]       ask OSV.dev about every pinned dependency; --os also the VM's Ubuntu packages (needs Docker)
#   ./dev clean              empty the dev database and every household file (refuses while a test run is going)
#   ./dev all                check, unit, sip, web, ui smoke, ui pwa
#
# Anything that uses Asterisk or the dev database holds one lock, so two runs can't
# trample each other (scenarios, browser tablets and cleanups all share them).
set -euo pipefail
cd "$(dirname "$0")"
ROOT="$PWD"
STATE="${TMPDIR:-/tmp}/treeline-dev-$(id -u)"
mkdir -p "$STATE"
VENV="$ROOT/.venv-dev"
UI_PORT="${UI_PORT:-18080}"
dc() { docker compose "$@"; }

locked() {   # run a command while holding the stack lock; say who has it if busy
  exec 9>"$STATE/stack.lock"
  if ! flock -n 9; then
    echo "Another test run holds the stack ($(cat "$STATE/stack.who" 2>/dev/null || echo unknown)). Wait for it; don't start a second." >&2
    exit 75
  fi
  echo "$* (pid $$, $(date +%T))" > "$STATE/stack.who"
  "$@"
}

# The dev Asterisk is the artifact production runs. compose needs its id and hash (build args); ./dev up puts the file where the
# image build looks, building it with asterisk/build/run-build.sh if it is not here, and refuses any file artifact.lock does not name.
if [ -f asterisk/build/artifact.lock ]; then
  ASTERISK_ID="$(python3 scripts/asterisk_build.py lock-field ARTIFACT_ID)"
  ASTERISK_SHA256="$(python3 scripts/asterisk_build.py lock-field ARTIFACT_SHA256)"
  export ASTERISK_ID ASTERISK_SHA256
fi
asterisk_artifact() {
  [ -n "${ASTERISK_ID:-}" ] || { echo "asterisk/build/artifact.lock is missing" >&2; return 1; }
  python3 scripts/asterisk_build.py check --require-lock >/dev/null || return 1
  local name="asterisk-$ASTERISK_ID.tar.gz" dest="asterisk/runtime/asterisk-$ASTERISK_ID.tar.gz" f
  mkdir -p asterisk/runtime
  right() { [ -f "$1" ] && echo "$ASTERISK_SHA256  $1" | sha256sum -c --status; }
  right "$dest" && return 0
  for f in "${ASTERISK_ARTIFACT:-/nonexistent}" "dist/asterisk/$name"; do
    if right "$f"; then cp "$f" "$dest"; return 0; fi
  done
  echo "building the Asterisk artifact (asterisk/build/run-build.sh, about two minutes)..." >&2
  asterisk/build/run-build.sh "$ROOT/dist/asterisk" >&2 || return 1
  right "dist/asterisk/$name" || { echo "the build produced a different artifact from the one artifact.lock names ($(sha256sum "dist/asterisk/$name" | cut -c1-16)... against ${ASTERISK_SHA256:0:16}...): the inputs changed without a new lock, or the build is not reproducible here" >&2; return 1; }
  cp "dist/asterisk/$name" "$dest"
}

stack_up() { asterisk_artifact && dc up -d --build "$@"; }

in_container() { dc run --rm --no-deps -T "$@"; }

cmd_up()      { stack_up; }
cmd_restart() { dc restart api controller >/dev/null; echo "restarted api and controller"; }

cmd_unit() {
  in_container --entrypoint python controller -m unittest "${@:-discover}" $([ $# -eq 0 ] && echo "-s tests -t .")
}

need_running() {
  for s in asterisk api controller; do
    dc ps --status running --services | grep -qx "$s" || { echo "$s isn't running: ./dev up" >&2; exit 1; }
  done
}

sip_run() { need_running; dc run --rm testphones "$@"; }
web_run() { need_running; dc run --rm webtests "${@:-phone_calls.py}"; }
cmd_sip() { locked sip_run "$@"; }
cmd_web() { locked web_run "$@"; }

# ---------------------------------------------------------------- local UI server
ui_py() {
  [ -x "$VENV/bin/python" ] || {
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q flask gunicorn pywebpush playwright
  }
}
ui_pid() { cat "$STATE/ui.pid" 2>/dev/null || true; }
ui_alive() { local p; p="$(ui_pid)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

ui_start() {
  ui_py
  if ui_alive; then echo "already running (pid $(ui_pid)) on :$UI_PORT"; return; fi
  # Something we didn't start (an old manual server) would answer instead of ours, with its own
  # stale database. Refuse, and say what it is.
  if ss -ltn 2>/dev/null | grep -q ":$UI_PORT "; then
    echo "port $UI_PORT is already in use by something ./dev didn't start:" >&2
    ss -ltnp 2>/dev/null | grep ":$UI_PORT " >&2
    echo "stop it (kill its master process, not just a worker), or set UI_PORT=<other>." >&2; exit 1
  fi
  mkdir -p "$STATE/ui" "$STATE/webroot" "$STATE/ui/bridge/req" "$STATE/ui/bridge/out" "$STATE/ui/bridge/deploy-req"   # the admin page's helper folders (the smoke test plays the helper)
  ln -sfn "$ROOT/design/ui" "$STATE/webroot/ui"; ln -sfn "$ROOT/web" "$STATE/webroot/site"
  # gunicorn writes its own master pid: `$!` of a backgrounded `cd && ... &` list is the wrapper
  # subshell, and killing that leaves the real server (and its old database) running.
  rm -f "$STATE/ui.pid"
  (cd "$ROOT/controller" && PYTHONPATH="$ROOT/controller" \
    TREELINE_DB="$STATE/ui/test.db" TREELINE_PJSIP_FILE="$STATE/ui/pjsip.conf" TREELINE_OUTBOX="$STATE/ui/outbox" \
    TREELINE_WEB="$STATE/webroot" TREELINE_DEV_CODES=1 ARI_URL=http://127.0.0.1:1/ari \
    TREELINE_BRIDGE_REQ="$STATE/ui/bridge/req" TREELINE_BRIDGE_OUT="$STATE/ui/bridge/out" TREELINE_BRIDGE_DEPLOY_REQ="$STATE/ui/bridge/deploy-req" \
    exec "$VENV/bin/gunicorn" --daemon --pid "$STATE/ui.pid" --log-file "$STATE/ui.log" \
      --bind "127.0.0.1:$UI_PORT" --workers 1 --threads 8 treeline.api:app)
  for _ in $(seq 40); do
    curl -s -m 1 "http://127.0.0.1:$UI_PORT/api/push/key" -o /dev/null && { echo "local API on http://127.0.0.1:$UI_PORT (pid $(ui_pid)); log: $STATE/ui.log"; return; }
    sleep 0.25
  done
  echo "local API failed to start; last log lines:" >&2; tail -5 "$STATE/ui.log" >&2
  if ss -ltn 2>/dev/null | grep -q ":$UI_PORT "; then echo "port $UI_PORT is held by something else (find it with: ss -ltnp | grep :$UI_PORT)" >&2; fi
  rm -f "$STATE/ui.pid"; exit 1
}
ui_stop() {
  if ui_alive; then kill "$(ui_pid)"; for _ in $(seq 20); do ui_alive || break; sleep 0.2; done; fi
  rm -f "$STATE/ui.pid"; echo "stopped"
}
ui_reset() { ui_stop; rm -f "$STATE/ui/test.db"*; rm -rf "$STATE/ui/households" "$STATE/ui/pre-migrate" "$STATE/ui/bridge"; ui_start; }       # a fresh database and household files, only ever while stopped
ui_test() {   # ui_test SCRIPT [VAR=value ...]: a throwaway local API, then a browser test against it
  local script="$1"; shift
  ui_reset
  ui_py
  env BASE="http://127.0.0.1:$UI_PORT" "$@" "$VENV/bin/python" "$script"
}
ui_pwa() { ui_test web/tests/pwa.py; }
ui_smoke() { ui_test web/tests/smoke.py SHOTS="${SHOTS:-$STATE/shots}" TREELINE_UI_DB="$STATE/ui/test.db"; }
cmd_ui() {
  case "${1:-status}" in
    start) ui_start ;; stop) ui_stop ;; reset) ui_reset ;; smoke) ui_smoke ;; pwa) ui_pwa ;;
    status) ui_alive && echo "running (pid $(ui_pid)) on :$UI_PORT" || echo "not running" ;;
    *) echo "ui start|stop|status|reset|smoke|pwa" >&2; exit 2 ;;
  esac
}

# ---------------------------------------------------------------- check
cmd_check() {
  local bad=0
  python3 scripts/build_web_assets.py >/dev/null; python3 scripts/build_licenses.py >/dev/null; python3 scripts/build_legal.py >/dev/null
  if ! git diff --quiet -- web/shared/assets.js web/parent/licenses.html web/phone/licenses.html web/legal || [ -n "$(git ls-files --others --exclude-standard web/legal)" ]; then
    echo "generated files were stale and have been regenerated: review and commit them"; bad=1
  fi
  for f in $(git ls-files 'web/**/*.js' | grep -v vendor/) ; do
    node --check --input-type=module < "$f" 2>/dev/null || { echo "JS syntax error: $f"; bad=1; }
  done
  for f in $(git ls-files '*.py'); do python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$f" || { echo "Python syntax error: $f"; bad=1; }; done
  python3 scripts/check_repo_rules.py || bad=1
  python3 -m unittest -q scripts/test_asterisk_build.py 2>/dev/null && python3 scripts/asterisk_build.py check >/dev/null || { echo "asterisk/build is out of step (python3 scripts/asterisk_build.py check says what)"; bad=1; }
  python3 -m unittest -q scripts/test_supply_chain.py 2>/dev/null || { echo "the bill of materials is out of step (python3 -m unittest scripts/test_supply_chain.py says what)"; bad=1; }
  python3 -m unittest -q scripts/test_legal.py 2>/dev/null || { echo "the legal pages or the agreement version are out of step (python3 -m unittest scripts/test_legal.py says what)"; bad=1; }
  dc config -q >/dev/null || { echo "docker-compose.yml is invalid"; bad=1; }
  docker compose -f deploy/docker-compose.prod.yml --env-file deploy/env.example config -q >/dev/null 2>&1 || { echo "deploy/docker-compose.prod.yml is invalid"; bad=1; }
  [ $bad -eq 0 ] && echo "check ok"; return $bad
}

cmd_rules() { python3 scripts/check_repo_rules.py "$@"; }
cmd_sbom() { python3 scripts/sbom.py "$@"; }
cmd_vulns() {   # the same check CI runs every day (.github/workflows/supply-chain.yml)
  local d; d="$(mktemp -d)"
  if [ "${1:-}" = "--os" ]; then
    scripts/os_packages.sh > "$d/os.tsv"
    python3 scripts/sbom.py --os-packages "$d/os.tsv" -o "$d/sbom.json"
  else
    python3 scripts/sbom.py -o "$d/sbom.json"
  fi
  local rc=0; python3 scripts/vuln_check.py "$d/sbom.json" --os-watch caddy,openssl,libsrtp2 || rc=$?
  rm -rf "$d"; return $rc
}
cmd_hooks() { git config core.hooksPath .githooks && echo "pre-commit hook on (.githooks/pre-commit): commits are scanned by scripts/check_repo_rules.py"; }

# ---------------------------------------------------------------- clean
clean_run() {
  # A current-layout database is emptied through the application: every household file goes through
  # households.remove() (safe for the api and controller, which may have them open), then the central rows.
  # An old-layout database (made before the data layer was split) is refused by the application, so that one
  # is removed by hand, with the api and controller stopped first: never delete a database a process has open.
  local rc=0
  clean_py || rc=$?
  if [ $rc -eq 3 ]; then
    echo "old-layout dev database: stopping the api and controller, removing it, starting them again"
    dc stop api controller >/dev/null
    dc run --rm --no-deps -T --entrypoint sh controller -c \
      'rm -f /data/treeline.db /data/treeline.db-wal /data/treeline.db-shm /data/treeline.db-journal; rm -rf /data/households /data/pre-migrate'
    clean_py
    dc start api controller >/dev/null
    return 0
  fi
  return $rc
}
clean_py() {
  dc run --rm --no-deps -T -e TREELINE_PJSIP_FILE=/generated/pjsip_handsets.conf -v "$ROOT/data/generated:/generated" \
    --entrypoint python controller -c "
import os, re, sys
from treeline import db, households, pjsip
try:
    c = db.connect()
except db.OldLayoutDatabase:
    sys.exit(3)
for tid in households.ids():
    households.remove(tid)
for name in os.listdir(households.root()) if os.path.isdir(households.root()) else []:
    if re.match(r'^\\d+\\.db-(wal|shm|journal)\$', name):           # leftovers of a household that is already gone
        os.remove(os.path.join(households.root(), name))
for t in ['call_event','call','string','ladder_code','grown_up','login_code','session','handset','pairing','push_subscription','treehouse','setting']:
    c.execute(f'DELETE FROM {t}')
pjsip.write(c); print('dev database emptied (central rows and every household file)')"
}
cmd_clean() {
  read -r -p "Empty the dev database (all families, calls, accounts)? [y/N] " a; [ "$a" = y ] || exit 1
  locked clean_run
}

cmd_native() { (cd deploy/native/tests && python3 -W error::ResourceWarning -m unittest -v "$@"); }
cmd_infra() {
  docker build -q -t treeline-shelltools - >/dev/null <<'EOF2'
FROM ubuntu:24.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq python3 openssl openssh-client >/dev/null && apt-get clean
EOF2
  docker run --rm -v "$ROOT":/r:ro treeline-shelltools bash -c 'bash /r/infra/bootstrap/test_bootstrap.sh && bash /r/infra/bootstrap/test_deploy.sh'
}
cmd_cdk() { infra/.venv/bin/python -m unittest discover -s infra/tests -v; }
cmd_vm() { python3 -m unittest -v deploy/native/ci/vm_test.py "$@"; }

cmd_all() { cmd_check; cmd_unit; cmd_native; cmd_infra; cmd_vm; cmd_sip; cmd_web phone_ui.py; cmd_web phone_calls.py; cmd_ui smoke; cmd_ui pwa; }

case "${1:-help}" in
  up) shift; cmd_up "$@" ;; restart) cmd_restart ;; unit) shift; cmd_unit "$@" ;;
  sip) shift; cmd_sip "$@" ;; web) shift; cmd_web "$@" ;; ui) shift; cmd_ui "$@" ;;
  native) shift; cmd_native "$@" ;; cdk) cmd_cdk ;; vm) shift; cmd_vm "$@" ;; infra) cmd_infra ;;
  check) cmd_check ;; rules) shift; cmd_rules "$@" ;; hooks) cmd_hooks ;; sbom) shift; cmd_sbom "$@" ;; vulns) shift; cmd_vulns "$@" ;; clean) cmd_clean ;; all) cmd_all ;;
  *) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
